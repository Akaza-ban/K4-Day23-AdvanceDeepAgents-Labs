# Copy this file to .env and fill in YOUR OWN keys. NEVER commit .env (it is in .gitignore).

# --- LLM (must support tool calling). Option 1: a LangChain provider ---
LAB_MODEL=openai:<model name>
OPENAI_API_KEY=
# LAB_MODEL=anthropic:<model name>
# ANTHROPIC_API_KEY=
# LAB_MODEL=google_genai:<model name>
# GOOGLE_API_KEY=

# --- LLM Option 2: any OpenAI-compatible endpoint (OpenRouter, Together, Groq, Ollama, vLLM, ...) ---
# LAB_BASE_URL=https://<endpoint>/v1
# LAB_MODEL=<model name>
# LAB_API_KEY=
LAB_TEMPERATURE=0

# --- Sandbox (Daytona): create a key at https://app.daytona.io ---
DAYTONA_API_KEY=

# --- Exa web search/fetch via MCP. The free tier is rate limited; a free key at https://dashboard.exa.ai/api-keys is recommended ---
EXA_API_KEY=
